@using System.Globalization
@using IKDFrontEnd.Models
@model TblUrlcontent
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="https://css.ishallwin.com/style/main-page.css" rel="stylesheet" async="">
<link href="https://css.ishallwin.com/style/study-section.css" rel="stylesheet" async="">
<link href="https://css.ishallwin.com/style/program-section.css" rel="stylesheet" async="">
<link href="https://css.ishallwin.com/style/college-section.css" rel="stylesheet" async="">
<link href="https://css.ishallwin.com/style/online-test-sec.css" rel="stylesheet" async="">
<link href="https://css.ishallwin.com/common/style.css" rel="stylesheet" async="">
@section MetaData {
    @if (Model != null)
    {
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta property="og:title" content="@Model.MetaTitle" />
        <meta property="og:description" content="@Model.MetaDescription" />
        <meta property="og:image" content="https://www.ilmkidunya.com/images/logo.png" />
        <meta name="description" content="@Model.MetaDescription">
        <meta name="keywords" content="@Model.MetaKeywords">
        <meta name="viewport" content="width=device-width, initial-scale=1">

        <title>@Model.MetaTitle</title>
    }
}


@section header {
    <!-- Header Start -->



    <div class="col-lg-11">
        <partial name="_NavBarPartial" />
    </div>

}


@section innerbanner {
    <div class="ss-banner-inner">
        <div class="ss-container">
            <div class="ss-row">
                <div class="ss-col-lg-12">
                    <div class="ss-text-holder">
                        @if (Model != null)
                        {
                            <h1>@Model.PageName</h1>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div id="main">
    <div class="ss-content has-bg">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">


                    @if (Model != null && Model.Content1 != null)
                    {
                        string Desc1 = Model.Content1.Replace("https://web.archive.org/web/20250522132322/", "");
                        @Html.RenderWithAds(Desc1)
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="ss-content">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    @await Html.PartialAsync("_maincontenttopbanner")
                </div>
            </div>
        </div>
    </div>

    <div class="contact-sec fee-box" style="padding-top: 0;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    @if (Model != null && Model.Content2 != null)
                    {
                        string desc3 = Model.Content2;
                        @Html.RenderWithAds(desc3)
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="contact-sec fee-box" style="padding-top: 0;">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    @if (Model != null && Model.Content3 != null)
                    {
                        string desc3 = Model.Content3;
                        @Html.RenderWithAds(desc3)
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="new-ads-sec">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12">
                    @await Html.PartialAsync("_maincontentlowerbanner")
                </div>
            </div>
        </div>
    </div>
</div>