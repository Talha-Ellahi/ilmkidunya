@if (ViewBag.Banners != null)
{

    var banners = ViewBag.Banners as List<IKDFrontEnd.Models.Banner>;
    var bannerSortOrder3 = banners?.FirstOrDefault(b => b.SortOrder == 3);
    var bannerSortOrder4 = banners?.FirstOrDefault(b => b.SortOrder == 4);
    var bannerSortOrder5 = banners?.FirstOrDefault(b => b.SortOrder == 5);

    <div class="new-banners" style=" padding:15px 0 20px 0;">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-12">
                    @if (bannerSortOrder3 != null)
                    {
                        var url3 = bannerSortOrder3.Url;

                        <a aria-label="link" data-advertiseid="@bannerSortOrder3.Id" class="banner-link decode-banner-url" onclick="handleBannerClick(this); return false;"
                        @if (url3.StartsWith("aHR0"))
                        {
                            <text>data-url='@url3'</text>
                        }
                        else
                        {
                            <text>href='@url3'</text>
                        }>
                            <img src="https://cdn.ilmkidunya.com/images/Banners/@bannerSortOrder3.Image"
                                    alt="image"  loading="lazy" decoding="async"/>
                        </a>
                    }
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12">
                    @if (bannerSortOrder4 != null)
                    {
                        var url4 = bannerSortOrder4.Url;

                        <a aria-label="link" data-advertiseid="@bannerSortOrder4.Id" class="banner-link decode-banner-url" onclick="handleBannerClick(this); return false;"
                        @if (url4.StartsWith("aHR0"))
                        {
                            <text>data-url='@url4'</text>
                        }
                        else
                        {
                            <text>href='@url4'</text>
                        }>
                            <img src="https://cdn.ilmkidunya.com/images/Banners/@bannerSortOrder4.Image"
                                    alt="image"  loading="lazy" decoding="async"/>
                        </a>
                    }
                </div>
                <div class="col-lg-4 col-md-4 col-sm-12">
                    @if (bannerSortOrder5 != null)
                    {
                        var url5 = bannerSortOrder5.Url;

                        <a aria-label="link" data-advertiseid="@bannerSortOrder5.Id" class="banner-link decode-banner-url" onclick="handleBannerClick(this); return false;"
                        @if (url5.StartsWith("aHR0"))
                        {
                            <text>data-url='@url5'</text>
                        }
                        else
                        {
                            <text>href='@url5'</text>
                        }>
                            <img src="https://cdn.ilmkidunya.com/images/Banners/@bannerSortOrder5.Image"
                                    alt="image"  loading="lazy" decoding="async"/>
                        </a>
                    }
                </div>
            </div>

            @if (ViewBag.HideGoogleAds != true)
            {
                <div class="col-lg-12">
                    <div class="google-ad-bx ad-slot">

                        <!-- ikd25 -->
                        <ins class="adsbygoogle"
                             style="display:block"
                             data-ad-client="ca-pub-8866825487085085"
                             data-ad-slot="9990874736"
                             data-ad-format="auto"
                             data-full-width-responsive="true"></ins>
                        <script>
                            (adsbygoogle = window.adsbygoogle || []).push({});
                        </script>

                    </div>
                </div>
            }

		</div>
	</div>



}
<script>
    function getDeviceType() {
        return window.innerWidth <= 780 ? "Mobile" : "Desktop";
    }

     document.addEventListener("DOMContentLoaded", function () {

            const observer = new IntersectionObserver(function(entries){

                entries.forEach(function(entry){

                    if(entry.isIntersecting){

                        $.post('/Banner/CountImpression',{

                            advertiseId: entry.target.dataset.advertiseid,

                            device: getDeviceType()

                        });

                        observer.unobserve(entry.target);

                    }

                });

            },{

                threshold:0.5

            });

                    document.querySelectorAll(".banner-link").forEach(function(item){

                observer.observe(item);

            });

            });

      function handleBannerClick(element) {
            var url = element.dataset.url;

            if (url.startsWith("aHR0"))
                url = atob(url);

            $.post('/Banner/CountClick', {

                advertiseId: element.dataset.advertiseid,

                device: getDeviceType()

            }, function () {

                window.open(url, "_blank");

            });

            return false;
        }
</script>